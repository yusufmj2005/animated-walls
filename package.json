{
  "name": "animated-walls",
  "version": "0.1.0",
  "private": true,
  "description": "Premium GPU-accelerated animated wallpaper platform for Windows.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/build-engine.mjs --dev && npm run dev -w @animated-walls/desktop",
    "build": "node scripts/build-engine.mjs && npm run build -w @animated-walls/desktop",
    "build:engine": "node scripts/build-engine.mjs",
    "typecheck": "tsc -p packages/tsconfig.json --noEmit && npm run typecheck -w @animated-walls/desktop",
    "test": "npm run test:ts && npm run test:engine",
    "test:ts": "vitest run",
    "test:engine": "dotnet test --solution engine/AnimatedWalls.Engine.slnx --filter-not-trait \"Category=Desktop\"",
    "test:engine:desktop": "dotnet test --solution engine/AnimatedWalls.Engine.slnx --filter-trait \"Category=Desktop\"",
    "test:e2e": "npm run samples && npm run build && npm run test:e2e -w @animated-walls/desktop",
    "package": "npm run build && npm run package -w @animated-walls/desktop",
    "package:dir": "npm run build && npm run package:dir -w @animated-walls/desktop",
    "samples": "node scripts/create-samples.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yazl": "^3.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yazl": "^3.3.1"
  }
}
